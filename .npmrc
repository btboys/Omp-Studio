# Download the Electron binary from the npmmirror China CDN instead of
# GitHub releases (electron's postinstall fetches the binary separately from
# the npm package; GitHub is often unreachable/slow from mainland China).
electron_mirror=https://npmmirror.com/mirrors/electron/
# Same for electron-builder's packaging binaries (nsis, winCodeSign, ...).
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
registry=https://registry.npmmirror.com/