{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "ES2024.Promise"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": ["src/main", "src/preload/index.ts", "electron.vite.config.ts"]
}
